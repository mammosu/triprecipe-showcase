<%= form_with(model: recipe, class: "space-y-8", html: { multipart: true }) do |form| %>
  <% if recipe.errors.any? %>
    <section class="rounded-[32px] border-[3px] border-red-500 bg-rose-50 px-5 py-4 text-sm font-semibold leading-relaxed text-red-700 shadow-[16px_16px_0_0_rgba(239,68,68,0.25)]">
      <p><%= pluralize(recipe.errors.count, "件") %>の入力エラーがあります。</p>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <% recipe.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="space-y-6">
    <details class="neo-card md:hidden p-4 text-sm text-slate-700">
      <summary class="cursor-pointer text-base font-black text-slate-900">入力ガイドを表示</summary>
      <ul class="mt-3 list-disc space-y-2 pl-5">
        <li>旅の目的を1行でまとめ、移動の制約があれば合わせて記載。</li>
        <li>同行者や予算感を書いておくと、後で共有するときに便利です。</li>
        <li>日数は余裕を持たせておき、あとから日ごとに詳しくします。</li>
      </ul>
    </details>

    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_280px]">
      <div class="space-y-6">
        <section class="neo-panel bg-white p-6">
          <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">基本情報</p>
          <h2 class="mt-2 inline-flex items-center gap-2 text-2xl font-black text-slate-900">
            <%= heroicon("map", classes: "h-5 w-5") %>
            <span>旅の概要</span>
          </h2>
          <div class="mt-6 space-y-5">
            <div class="space-y-2">
              <%= form.label :title, "タイトル", class: "text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
              <p class="text-sm font-semibold text-slate-700">例: 家族で楽しむ沖縄3泊4日、美術館を巡るパリ週末旅など</p>
              <%= form.text_field :title, class: "w-full rounded-2xl border-[3px] border-slate-900 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-0" %>
            </div>

            <div class="grid gap-5 md:grid-cols-2">
              <div class="space-y-2" data-controller="city-autocomplete"
                   data-city-autocomplete-url-value="<%= cities_path %>"
                   data-city-autocomplete-selected-id-value="<%= recipe.city_id %>">
                <%= form.label :city_display, "都市/エリア", class: "text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
                <p class="text-xs font-semibold text-slate-600">都市名を入力すると候補が表示されます。候補にない場合はそのままの表記で保存できます。</p>
                <div class="relative">
                  <%= form.text_field :city_display,
                                      class: "w-full rounded-2xl border-[3px] border-slate-900 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-0",
                                      autocomplete: "off",
                                      data: {
                                        city_autocomplete_target: "input",
                                        action: "input->city-autocomplete#search focus->city-autocomplete#search blur->city-autocomplete#scheduleHide"
                                      } %>
                  <%= form.hidden_field :city_id, data: { city_autocomplete_target: "hidden" } %>
                  <div class="absolute z-20 mt-1 hidden w-full rounded-2xl border-[3px] border-slate-900 bg-white shadow-[8px_8px_0_0_#0f172a]"
                       data-city-autocomplete-target="results"></div>
                </div>
                <button type="button"
                        class="text-xs font-bold text-primary-600 hover:underline"
                        data-action="city-autocomplete#clearSelection">
                  選択をクリア
                </button>
              </div>
              <div class="space-y-2">
                <%= form.label :days_count, "日数", class: "text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
                <%= form.number_field :days_count, in: 1..60, class: "w-full rounded-2xl border-[3px] border-slate-900 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-0" %>
              </div>
            </div>

            <div class="space-y-2">
              <%= form.label :description, "概要（旅の目的・やりたいこと）", class: "text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
              <p class="text-sm font-semibold text-slate-700">箇条書きでもOK。移動手段や必須スポットをメモしておくと、あとで日ごとの予定を入れやすくなります。</p>
              <%= form.text_area :description, rows: 6, class: "w-full rounded-2xl border-[3px] border-slate-900 px-3 py-2 text-sm leading-relaxed focus:border-primary-500 focus:outline-none focus:ring-0" %>
            </div>

            <% if @active_tags.present? %>
              <div class="space-y-2">
                <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">タグ</p>
                <p class="text-sm font-semibold text-slate-700">旅の特徴に合うタグを選択できます（複数可）。</p>
                <div class="flex flex-wrap gap-2">
                  <%= form.collection_check_boxes :tag_ids, @active_tags, :id, :display_label do |tag| %>
                    <label class="inline-flex items-center">
                      <%= tag.check_box(class: "peer sr-only") %>
                      <span class="inline-flex items-center gap-2 rounded-full border-2 border-slate-900 bg-white px-3 py-1 text-xs font-semibold text-slate-900 shadow-[2px_2px_0_0_rgba(15,23,42,0.3)] hover:bg-gray-50 peer-checked:border-primary-300 peer-checked:bg-primary-100 peer-checked:text-primary-700 peer-checked:hover:bg-primary-200 cursor-pointer">
                        <span class="hidden h-4 w-4 items-center justify-center rounded-full border border-slate-900 text-[10px] font-black text-slate-900 peer-checked:inline-flex">
                          ✓
                        </span>
                        <%= tag.text %>
                      </span>
                    </label>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="space-y-2">
              <%= form.label :cover_image, "カバー画像", class: "text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
              <p class="text-sm font-semibold text-slate-700">一覧のサムネや詳細ヘッダーに表示します（PNG/JPEG/WEBP・5MBまで）。</p>
              <%= form.file_field :cover_image,
                                  accept: "image/png,image/jpeg,image/webp",
                                  class: "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-0" %>
              <% if recipe.cover_image.attached? %>
                <div class="mt-4 space-y-3">
                  <div class="overflow-hidden rounded-2xl border-[3px] border-slate-900 bg-slate-100">
                    <%= image_tag recipe.cover_image.variant(resize_to_limit: [640, 360]),
                                  class: "h-full w-full object-cover",
                                  alt: "現在のカバー画像" %>
                  </div>
                  <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                    <%= form.check_box :remove_cover_image,
                                       class: "h-4 w-4 rounded border-[3px] border-slate-900 text-primary-600 focus:ring-primary-500" %>
                    <span>カバー画像を削除する</span>
                  </label>
                </div>
              <% end %>
            </div>
          </div>
        </section>

        <section class="neo-panel bg-white p-6">
          <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">公開設定</p>
          <h2 class="mt-2 inline-flex items-center gap-2 text-2xl font-black text-slate-900">
            <%= heroicon("share", classes: "h-5 w-5") %>
            <span>共有範囲</span>
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2" role="radiogroup" aria-label="公開範囲">
            <label class="neo-card flex items-start gap-3 px-4 py-3 data-[active=true]:border-primary-300 data-[active=true]:bg-primary-50"
                   data-active="<%= recipe.public? %>">
              <%= form.radio_button :public, true, class: "mt-1" %>
              <span>
                <span class="block text-sm font-black text-slate-900">公開</span>
                <span class="text-xs font-semibold text-slate-600">公開ギャラリーや共有リンクに表示</span>
              </span>
            </label>
            <label class="neo-card flex items-start gap-3 px-4 py-3 data-[active=true]:border-primary-300 data-[active=true]:bg-primary-50"
                   data-active="<%= !recipe.public? %>">
              <%= form.radio_button :public, false, class: "mt-1" %>
              <span>
                <span class="block text-sm font-black text-slate-900">非公開（下書き）</span>
                <span class="text-xs font-semibold text-slate-600">自分だけのメモとして保存</span>
              </span>
            </label>
          </div>
        </section>
      </div>

      <aside class="hidden space-y-5 neo-panel bg-white p-6 text-sm font-semibold text-slate-700 md:block">
        <h3 class="inline-flex items-center gap-2 text-base font-black text-slate-900">
          <%= heroicon("information-circle", classes: "h-4 w-4") %>
          <span>入力ガイド</span>
        </h3>
        <ul class="space-y-2">
          <li>1. 旅の目的（例: グルメ、リゾート、ワーケーション）を一言で表す。</li>
          <li>2. 移動や宿泊の制約があれば概要に明記。</li>
          <li>3. 日数は余裕を持たせ、あとから日ごとに微調整。</li>
        </ul>
        <div class="neo-dashed px-4 py-3">
          <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">プレビュー</p>
          <p class="text-lg font-black text-slate-900"><%= recipe.title.presence || "タイトル未設定" %></p>
          <p class="text-xs font-semibold text-slate-600">
            <%= [recipe.city_label.presence || "都市未設定", (recipe.days_count ? "#{recipe.days_count}日" : "日数未設定")].join(" / ") %>
          </p>
        </div>
      </aside>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= render "shared/components/button", label: (recipe.new_record? ? "レシピを保存" : "更新する"), variant: :neo_primary, button_type: :submit, form: form %>
    <%= render "shared/components/button", label: "キャンセル", variant: :neo_secondary, href: recipes_path %>
  </div>
<% end %>
