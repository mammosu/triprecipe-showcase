<% content_for :title, "履歴 - #{@recipe.title}" %>

<div class="mx-auto max-w-5xl px-4 py-8 space-y-6">
  <div class="mb-4 flex items-center gap-2 text-sm">
    <%= link_to recipe_path(@recipe), class: "inline-flex items-center gap-1 font-semibold text-slate-600 hover:text-slate-900" do %>
      <%= heroicon("arrow-left", classes: "h-4 w-4") %>
      <span>レシピに戻る</span>
    <% end %>
  </div>

  <section class="neo-panel bg-white p-6">
    <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">履歴</p>
    <h1 class="mt-2 text-3xl font-black text-slate-900">履歴</h1>
    <p class="mt-2 text-sm font-semibold text-slate-700">操作ログと差分をタブで確認できます。</p>
  </section>

  <div data-controller="tabs">
    <div class="mb-4 flex gap-2 text-sm">
      <button type="button"
              class="tab-button neo-btn-brutal bg-primary-100 text-sm font-black hover:cursor-pointer"
              data-action="click->tabs#show"
              data-tabs-target="tab"
              data-tabs-name="events">
        操作履歴
      </button>
      <button type="button"
              class="tab-button neo-btn-brutal bg-white text-sm font-black hover:cursor-pointer"
              data-action="click->tabs#show"
              data-tabs-target="tab"
              data-tabs-name="diffs">
        内容の差分
      </button>
    </div>

    <div data-tabs-target="panel" data-tabs-name="events">
      <% if @audit_logs.present? %>
        <div class="divide-y divide-gray-100 rounded-[32px] border-[3px] border-slate-900 bg-white shadow-[10px_10px_0_0_#0f172a]">
          <% @audit_logs.each do |log| %>
            <%= render "audit_logs/event", log: log %>
          <% end %>
        </div>
      <% else %>
        <div class="neo-dashed text-center">
          操作履歴はまだありません。
        </div>
      <% end %>
    </div>

    <div data-tabs-target="panel" data-tabs-name="diffs" hidden>
      <% if @versions.any? %>
        <div class="divide-y divide-gray-100 rounded-[32px] border-[3px] border-slate-900 bg-white shadow-[10px_10px_0_0_#0f172a]">
          <% @versions.each do |v| %>
            <div class="p-4 space-y-1">
              <div class="flex items-center justify-between text-sm">
                <span class="inline-flex items-center gap-2">
                  <span class="rounded-full border-[3px] border-slate-900 bg-gray-100 px-2 py-1 text-xs font-black text-slate-700">
                    <%= version_event_label(v.event) %>
                  </span>
                  <span class="text-xs font-semibold text-slate-600">
                  <%= version_model_label(v.item_type) %>
                  </span>
                  <% if policy(@recipe).manage_collaborators? %>
                    <% restorable = restorable_version?(v) %>
                    <span class="rounded-full border-[2px] border-slate-900 px-2 py-0.5 text-[10px] font-black <%= restorable ? "bg-emerald-100 text-emerald-700" : "bg-slate-100 text-slate-500" %>">
                      <%= restorable ? "復元可" : "復元不可" %>
                    </span>
                  <% end %>
                </span>
                <span class="text-xs font-semibold text-slate-600"><%= v.created_at.strftime("%Y/%m/%d %H:%M") %></span>
              </div>
              <% actor = User.find_by(id: v.whodunnit)&.email || v.try(:actor_email) %>
              <div class="text-sm font-semibold text-slate-800">
                実行者: <%= actor.presence || "不明" %>
              </div>
              <%= render "shared/components/version_changeset", version: v, compact: true %>
              <%= link_to "詳細",
                          recipe_version_path(@recipe, v, return_to: recipe_history_path(@recipe, tab: "diffs")),
                          class: "text-xs font-black text-primary-600 hover:underline" %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="neo-dashed text-center">
          内容の差分はまだありません。
        </div>
      <% end %>
    </div>
  </div>
</div>
