<% content_for :title, "旅のレシピ" %>

<div class="space-y-12">
  <section class="neo-panel bg-[#fffef6] p-8 space-y-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="space-y-4">
        <p class="neo-chip uppercase tracking-[0.4em]">レシピ集</p>
        <h1 class="text-4xl font-black text-slate-900">真似できる旅のレシピを探す</h1>
        <p class="text-sm font-semibold leading-relaxed text-slate-700">
          実際の旅の行程を分かりやすく整理し、参考にしやすい形で保存できます。
        </p>
      </div>
      <div class="flex flex-col gap-3 text-sm font-black sm:flex-row">
        <% if user_signed_in? %>
          <%= link_to new_recipe_path,
                      class: "neo-btn-brutal bg-primary-100" do %>
            <%= heroicon("plus-circle", classes: "h-4 w-4 text-slate-900") %>
            <span class="whitespace-nowrap">レシピを作成</span>
          <% end %>
        <% else %>
          <%= link_to new_user_session_path,
                      class: "neo-btn-brutal bg-primary-100" do %>
            <%= heroicon("lock-closed", classes: "h-4 w-4 text-slate-900") %>
            <span class="whitespace-nowrap">ログインして作成</span>
          <% end %>
        <% end %>
        <a href="#public-plans"
           class="neo-btn-brutal bg-white">
          <%= heroicon("globe-alt", classes: "h-5 w-5 text-slate-900") %>
          <span class="whitespace-nowrap">公開レシピを見る</span>
        </a>
      </div>
    </div>
  </section>

  <div class='pt-4 mb-0'></div>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="neo-panel bg-white p-6">
      <h2 class="inline-flex items-center gap-2 text-lg font-black text-slate-900">
        <%= heroicon("map", classes: "h-5 w-5") %>
        <span>マイレシピ</span>
      </h2>
      <p class="mt-2 text-sm font-semibold text-slate-700">下書きと公開中のレシピを一覧でまとめて確認できます。</p>

      <% if user_signed_in? %>
        <% if @my_recipes.present? %>
          <ul class="mt-4 space-y-3">
            <% @my_recipes.limit(5).each do |plan| %>
              <li>
                <%= render "shared/components/plan_card", plan: plan, compact: true %>
              </li>
            <% end %>
          </ul>
          <% if @my_recipes.size > 5 %>
            <p class="mt-4 text-xs font-semibold text-slate-600">今は最新5件まで表示しています。全件表示は準備中です。</p>
          <% end %>
        <% else %>
          <div class="neo-dashed mt-4 text-sm font-semibold text-slate-700">
            まだレシピがありません。旅行のテーマや都市を決めて「＋ レシピを作成」から登録してみましょう。
          </div>
        <% end %>
      <% else %>
        <div class="neo-dashed mt-4 text-sm font-semibold text-slate-700">
          ログインすると自分だけのレシピを保存できます。
        </div>
      <% end %>
    </div>

    <% if user_signed_in? %>
      <div class="favorite_recipes neo-panel bg-white p-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-lg font-black text-slate-900">お気に入り</h2>
            <p class="mt-1 text-sm font-semibold text-slate-700">気になった公開レシピを一括で確認。</p>
          </div>
            <%= link_to saved_recipes_path, class: "neo-chip neo-chip--pill text-slate-900" do %>
              <%= heroicon("heart", classes: "h-4 w-4") %>
              <span>一覧</span>
            <% end %>
        </div>

        <% if @favorite_recipes.present? %>
          <ul class="favorite_recipes__list mt-4 space-y-3">
            <% @favorite_recipes.limit(4).each do |plan| %>
              <li>
                <%= render "shared/components/plan_card", plan: plan, compact: true %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="neo-dashed mt-4 text-sm font-semibold text-slate-700">
            まだお気に入りはありません。公開ギャラリーのハートボタンで登録できます。
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <% if @popular_recipes.present? %>
    <section class="neo-panel bg-[#fef9ed] p-6">
      <div class="flex items-center gap-2">
        <%= heroicon("sparkles", classes: "h-5 w-5 text-amber-500") %>
        <h2 class="text-lg font-black text-slate-900">人気のレシピ</h2>
      </div>
      <p class="mt-2 text-sm font-semibold text-slate-700">直近30日のお気に入り数に基づくトップレシピ</p>
      <ul class="mt-5 space-y-3">
        <% @popular_recipes.each do |plan| %>
          <li>
            <%= render "shared/components/plan_card", plan: plan %>
          </li>
        <% end %>
      </ul>
      <div class="mt-4">
        <%= render 'shared/components/pagy_nav_tailwind', pagy: @pagy_popular %>
      </div>
    </section>
  <% end %>

  <%= turbo_frame_tag "public_recipes", data: { controller: "scroll-to-top", action: "turbo:frame-load->scroll-to-top#scroll" } do %>
    <section class="neo-panel bg-white p-6">
      <div class="md:flex md:flex-col md:items-start md:gap-10">
        <div class="md:w-full">
          <h2 id="public-plans" class="inline-flex items-center gap-2 text-lg font-black text-slate-900">
            <%= heroicon("globe-alt", classes: "h-5 w-5") %>
            <span>公開レシピギャラリー</span>
          </h2>
          <p class="text-sm font-semibold text-slate-700">見やすく一覧できます。気に入ったら保存して次の旅に役立てられます。</p>
        </div>

        <div class="mt-6 md:mt-0 md:w-full">
          <%= form_with url: recipes_path, method: :get, local: true,
                        data: { turbo_frame: "public_recipes" },
                        class: "grid gap-4 md:grid-cols-2 md:gap-x-6 md:gap-y-4 text-sm font-semibold text-slate-700" do |form| %>

            <div>
              <label class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">キーワード</label>
              <%= form.text_field :query,
                                  value: @query,
                                  placeholder: "例: 家族旅行 / 美術館 / グルメ",
                                  class: "mt-2 w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-0" %>
            </div>
            <div data-controller="city-autocomplete"
                data-city-autocomplete-url-value="<%= cities_path %>"
                data-city-autocomplete-selected-id-value="<%= @city_filter %>">
              <label class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">都市で絞り込み</label>
              <div class="relative mt-2">
                <%= form.text_field :city_display,
                                    value: @city_filter_display,
                                    placeholder: "都市名を入力",
                                    autocomplete: "off",
                                    class: "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm focus:border-primary-500 focus:outline-none focus:ring-0",
                                    data: {
                                      city_autocomplete_target: "input",
                                      action: "input->city-autocomplete#search focus->city-autocomplete#search blur->city-autocomplete#scheduleHide"
                                    } %>
                <%= form.hidden_field :city_id, value: @city_filter, data: { city_autocomplete_target: "hidden" } %>
                <div class="absolute z-20 mt-1 hidden w-full rounded-2xl border-[3px] border-slate-900 bg-white shadow-[8px_8px_0_0_#0f172a]"
                    data-city-autocomplete-target="results"></div>
              </div>
            </div>
            <div class="md:col-span-2 md:flex md:items-end md:justify-between md:gap-6">
              <% if @active_tags.present? %>
                <div class="min-w-0 md:flex-1">
                  <label class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">タグ</label>
                  <div class="mt-2 flex flex-wrap gap-2">
                    <% @active_tags.each do |tag| %>
                      <% active = @tag_filters.include?(tag.key) %>
                      <label class="inline-flex items-center">
                        <%= check_box_tag "tags[]", tag.key, active, class: "peer sr-only" %>
                        <span class="inline-flex items-center gap-2 rounded-full border-2 border-slate-900 bg-white px-3 py-1 text-xs font-semibold text-slate-900 shadow-[2px_2px_0_0_rgba(15,23,42,0.3)] hover:bg-gray-50 peer-checked:border-primary-300 peer-checked:bg-primary-100 peer-checked:text-primary-700 peer-checked:hover:bg-primary-200 cursor-pointer">
                          <span class="hidden h-4 w-4 items-center justify-center rounded-full border border-slate-900 text-[10px] font-black text-slate-900 peer-checked:inline-flex">
                            ✓
                          </span>
                          <%= tag.display_label %>
                        </span>
                      </label>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <div class="mt-3 md:mt-0 flex flex-col gap-2 md:flex-row md:items-center shrink-0">
                <button type="submit" class="neo-btn-brutal bg-primary-100">
                  検索
                </button>
                <% if @city_filter.present? || @query.present? || @tag_filters.present? %>
                  <%= link_to "リセット", recipes_path, class: "neo-btn-brutal bg-white" %>
                <% end %>
              </div>
            </div>

          <% end %>
        </div>
      </div>

      <% if @public_recipes.present? %>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          <% @public_recipes.each do |plan| %>
            <%= render "recipe_card", recipe: plan %>
          <% end %>

        </div>
        <div class="mt-6">
          <%= render 'shared/components/pagy_nav_tailwind', pagy: @pagy_public %>
        </div>
      <% else %>
        <div class="neo-dashed mt-6 text-sm font-semibold text-slate-700">
          公開レシピはまだありません。最初のレシピを投稿してコミュニティに共有しましょう。
        </div>
      <% end %>
    </section>
  <% end %>
</div>
