<% plan_title = @recipe.title.presence || "無題のレシピ" %>
<% city_label = @recipe.city_label.presence || "旅行レシピ" %>
<% description_snippet = @recipe.description.presence || "#{plan_title} (#{city_label}) の行程を共有しています。" %>
<% content_for :title, "#{plan_title} | TripRecipe" %>
<% content_for :meta_description, truncate(strip_tags(description_snippet), length: 150) %>
<% content_for :canonical_url, recipe_url(@recipe) %>
<% if @recipe.cover_image.attached? %>
  <% og_image_url = rails_blob_url(@recipe.cover_image.variant(resize_to_limit: [1200, 630]),
                                   host: request.base_url) %>
  <% content_for :og_image, og_image_url %>
  <% content_for :twitter_card, "summary_large_image" %>
<% end %>

<div data-controller="report-modal" data-action="keydown@window->report-modal#handleKeydown">
<article class="space-y-10">
  <section class="neo-panel bg-[#fffef6] p-6 sm:p-10">
    <% if @share_link_access_granted %>
      <div class="mb-6 neo-dashed border-emerald-500 text-sm font-semibold text-emerald-700">
        共有リンク経由で表示しています。リンクを知っている人のみ閲覧できます。
      </div>
    <% end %>
    <p class="neo-chip uppercase tracking-[0.5em] text-slate-900"><%= @recipe.city_label.presence || "都市未設定" %></p>
    <h1 class="mt-4 text-4xl font-black text-slate-900"><%= plan_title %></h1>
    <p class="mt-3 text-base font-semibold leading-relaxed text-slate-700">
      滞在イメージや主要スポットをまとめて、あとから日ごとの予定に分けて整理できます。
    </p>
    <% if @recipe.cover_image.attached? %>
      <div class="mt-6 overflow-hidden rounded-[32px] border-[3px] border-slate-900 bg-slate-100">
        <%= image_tag @recipe.cover_image.variant(resize_to_limit: [1280, 720]),
                      class: "aspect-[16/9] h-full w-full object-cover",
                      alt: "#{plan_title}のカバー画像" %>
      </div>
    <% end %>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="neo-card bg-white p-4">
        <p class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600">
          <%= heroicon("map-pin", classes: "h-4 w-4") %>
          都市
        </p>
        <p class="mt-2 text-lg font-black text-slate-900"><%= @recipe.city_label.presence || "未設定" %></p>
      </div>
      <div class="neo-card bg-white p-4">
        <p class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600">
          <%= heroicon("calendar", classes: "h-4 w-4") %>
          日数
        </p>
        <p class="mt-2 text-lg font-black text-slate-900"><%= @recipe.days_count.present? ? "約#{@recipe.days_count}日" : "未設定" %></p>
      </div>
      <div class="neo-card bg-white p-4">
        <p class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600">
          <%= heroicon(@recipe.public? ? "eye" : "eye-slash", classes: "h-4 w-4") %>
          公開ステータス
        </p>
        <p class="mt-2 text-lg font-black text-slate-900"><%= @recipe.public? ? "公開" : "非公開" %></p>
      </div>
      <div class="neo-card bg-white p-4">
        <p class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600">
          <%= heroicon("user-circle", classes: "h-4 w-4") %>
          作成者
        </p>
        <p class="mt-2 text-lg font-black text-slate-900"><%= display_user_identifier(@recipe.user) %></p>
      </div>
    </div>

    <% fork_source = @recipe.forked_from_recipe %>
    <% if fork_source.present? %>
      <div class="mt-6 neo-card bg-white p-4">
        <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">コピー元</p>
        <div class="mt-2 flex flex-wrap items-center gap-2 text-sm font-semibold text-slate-700">
          <%= heroicon("arrow-path", classes: "h-4 w-4") %>
          <% if fork_source.public? %>
            <%= link_to fork_source.title, recipe_path(fork_source), class: "text-primary-600 hover:underline" %>
          <% else %>
            <span><%= fork_source.title %></span>
          <% end %>
          <% if fork_source.user.present? %>
            <span class="text-xs font-semibold text-slate-500">by <%= display_user_identifier(fork_source.user) %></span>
          <% end %>
          <% unless fork_source.public? %>
            <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600">非公開</span>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="mt-6 flex-wrap gap-3 text-sm font-black flex">
      <%= link_to recipes_path,
                  class: "neo-btn-brutal bg-white" do %>
        <%= heroicon("home", classes: "h-4 w-4") %>
        <span>一覧へ戻る</span>
      <% end %>
      <% if policy(@recipe).update? %>
        <%= link_to edit_recipe_path(@recipe),
                    class: "neo-btn-brutal bg-primary-100" do %>
          <%= heroicon("pencil-square", classes: "h-4 w-4") %>
          <span>このレシピを編集</span>
        <% end %>
      <% end %>
      <% if policy(@recipe).fork? %>
        <%= button_to fork_recipe_path(@recipe),
                      method: :post,
                      class: "neo-btn-brutal bg-emerald-300 cursor-pointer" do %>
          <%= heroicon("arrow-path", classes: "h-4 w-4") %>
          <span>このレシピをベースに作る</span>
        <% end %>
      <% end %>
      <% if policy(@recipe).manage_collaborators? %>
        <%= link_to recipe_collaborators_path(@recipe),
                    class: "neo-btn-brutal bg-white" do %>
          <%= heroicon("users", classes: "h-4 w-4") %>
          <span>コラボレーター管理</span>
        <% end %>
        <%= link_to recipe_history_path(@recipe),
                    class: "neo-btn-brutal bg-white" do %>
          <%= heroicon("clock", classes: "h-4 w-4") %>
          <span>履歴</span>
        <% end %>
      <% end %>
      <% if owns_recipe? %>
        <%= button_to @recipe,
                      method: :delete,
                      data: { confirm: "本当に削除しますか？" },
                      class: "neo-btn-brutal bg-white text-red-600 cursor-pointer" do %>
          <%= heroicon("trash", classes: "h-4 w-4") %>
          <span>レシピを削除</span>
        <% end %>
      <% end %>
      <div class="hidden sm:block">
        <%= render "shared/components/favorite_button", recipe: @recipe, saved: @recipe_saved %>
      </div>
      <% if policy(RecipeReport.new(recipe: @recipe)).create? %>
        <button type="button"
                class="ml-auto text-amber-600 cursor-pointer"
                data-action="report-modal#open">
          <%= heroicon("exclamation-triangle", classes: "h-4 w-4 m-auto") %>
          <span><%= t("recipes.reports.button") %></span>
        </button>
      <% end %>
    </div>
  </section>

  <% if owns_recipe? %>
    <% active_token = @active_share_token %>
    <section class="neo-panel bg-white p-6">
      <header class="flex items-center justify-between">
        <div>
          <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">共有リンク</p>
          <h2 class="inline-flex items-center gap-2 text-2xl font-black text-slate-900">
            <%= heroicon("share", classes: "h-5 w-5") %>
            <span>限定公開用リンク</span>
          </h2>
        </div>
        <% if active_token %>
          <div class="text-right text-xs font-semibold text-slate-700">
            <p>有効期限 <%= active_token.expires_at&.strftime("%Y/%m/%d") || "なし" %></p>
            <p>最終アクセス <%= active_token.last_accessed_at&.strftime("%Y/%m/%d %H:%M") || "未アクセス" %></p>
          </div>
        <% end %>
      </header>

      <% if active_token %>
        <p class="mt-3 text-sm font-semibold text-slate-700">以下の URL を共有すると、ログイン不要でこのレシピを閲覧できます。</p>
        <div class="mt-4 flex flex-col gap-3 md:flex-row md:items-center"
             data-controller="copy-to-clipboard"
             data-copy-to-clipboard-url-value="<%= share_recipe_url(active_token.token) %>">
          <code class="flex-1 rounded-2xl border-[3px] border-slate-900 bg-gray-50 px-4 py-3 text-sm font-semibold text-slate-900 overflow-x-auto whitespace-nowrap"
                data-copy-to-clipboard-target="preview">
            <%= share_recipe_url(active_token.token) %>
          </code>
          <button type="button"
                  class="neo-btn-brutal bg-white text-emerald-600"
                  data-copy-to-clipboard-target="button"
                  data-action="click->copy-to-clipboard#copy">
            <%= heroicon("link", classes: "h-4 w-4") %>
            <span>リンクをコピー</span>
          </button>
          <%= button_to extend_lifespan_recipe_share_token_path(@recipe, active_token),
                method: :post,
                class: "neo-btn-brutal bg-white text-indigo-600" do %>
            <%= heroicon("clock", classes: "h-4 w-4") %>
            <span>有効期限を30日延長</span>
          <% end %>
          <%= button_to recipe_share_tokens_path(@recipe), method: :post,
                data: { turbo_confirm: "既存の共有リンクはすべて無効になります。再発行しますか？" },
                class: "neo-btn-brutal bg-primary-100" do %>
            <%= heroicon("share", classes: "h-4 w-4") %>
            <span>リンクを再発行</span>
          <% end %>
          <%= button_to recipe_share_token_path(@recipe, active_token), method: :delete,
                data: { turbo_confirm: "共有リンクを無効化しますか？" },
                class: "neo-btn-brutal bg-white text-red-600" do %>
            <%= heroicon("trash", classes: "h-4 w-4") %>
            <span>リンクを無効化</span>
          <% end %>
        </div>
      <% else %>
        <p class="mt-3 text-sm font-semibold text-slate-700">まだ共有リンクは発行していません。発行するとリンクを知る人だけに限定公開できます。</p>
        <%= button_to recipe_share_tokens_path(@recipe), method: :post,
              class: "mt-4 neo-btn-brutal bg-emerald-300" do %>
          <%= heroicon("share", classes: "h-4 w-4") %>
          <span>共有リンクを発行</span>
        <% end %>
      <% end %>
    </section>

    <% if @share_token_history.present? %>
      <section class="mt-6 neo-panel bg-white p-6">
        <header class="mb-4">
          <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">共有リンク履歴</p>
          <h3 class="inline-flex items-center gap-2 text-xl font-black text-slate-900">
            <%= heroicon("document-text", classes: "h-5 w-5") %>
            <span>発行・アクセス状況</span>
          </h3>
        </header>
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm font-semibold text-slate-700">
            <thead class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">
              <tr>
                <th class="pb-2 pr-4">状態</th>
                <th class="pb-2 pr-4">最終アクセス</th>
                <th class="pb-2 pr-4">有効期限</th>
                <th class="pb-2 pr-4">発行日時</th>
                <th class="pb-2">トークン</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @share_token_history.each do |token| %>
                <tr>
                  <td class="py-2 pr-4 font-semibold">
                    <% if token.active? %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-1 text-emerald-700 text-xs">
                        <%= heroicon("check-circle", classes: "h-3.5 w-3.5") %>
                        有効
                      </span>
                    <% elsif token.revoked_at.present? %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2 py-1 tr-text-sub text-xs">
                        <%= heroicon("eye-slash", classes: "h-3.5 w-3.5") %>
                        無効化
                      </span>
                    <% else %>
                      <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-1 text-amber-700 text-xs">
                        <%= heroicon("clock", classes: "h-3.5 w-3.5") %>
                        期限切れ
                      </span>
                    <% end %>
                  </td>
                  <td class="py-2 pr-4"><%= token.last_accessed_at&.strftime("%Y/%m/%d %H:%M") || "-" %></td>
                  <td class="py-2 pr-4"><%= token.expires_at&.strftime("%Y/%m/%d") || "なし" %></td>
                  <td class="py-2 pr-4"><%= token.created_at.strftime("%Y/%m/%d") %></td>
                  <td class="py-2 font-mono text-xs tr-text-sub" title="クリックでコピー済みタブから確認してください">
                    <% masked = token.token.to_s %>
                    <%= masked.present? ? "#{masked.first(6)}…" : "-" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% end %>

  <section class="neo-panel bg-white p-6">
    <header class="mb-4 flex items-center justify-between">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">概要</p>
        <h2 class="inline-flex items-center gap-2 text-2xl font-black text-slate-900">
          <%= heroicon("document-text", classes: "h-5 w-5") %>
          <span>旅のコンセプト</span>
        </h2>
      </div>
      <span class="text-xs font-semibold text-slate-600">
        最終更新 <%= @recipe.updated_at.strftime("%Y/%m/%d") %>
        <% if false %>
          <% if @recipe.last_edited_by_email.present? %>
            ・ <%= @recipe.last_edited_by_email %>
          <% elsif @recipe.last_edited_by.present? %>
            ・ <%= display_user_identifier(@recipe.last_edited_by) %>
          <% end %>
        <% end %>
      </span>
    </header>
    <div class="prose max-w-none text-slate-800">
      <%= simple_format(@recipe.description.presence || "まだ説明がありません。目的・移動手段・マストスポットなどを書き留めましょう。") %>
    </div>
  </section>

  <section class="neo-panel bg-white p-6">
    <header class="mb-4 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">日別行程</p>
        <h2 class="inline-flex items-center gap-2 text-2xl font-black text-slate-900">
          <%= heroicon("calendar", classes: "h-5 w-5") %>
          <span>日別タイムライン</span>
        </h2>
      </div>
      <% if owns_recipe? %>
        <%= link_to new_recipe_day_path(@recipe),
            class: "neo-btn-brutal bg-primary-100 text-sm font-black" do %>
          <%= heroicon("plus-circle", classes: "h-4 w-4") %>
          <span>日程を追加</span>
        <% end %>
      <% end %>
    </header>

    <% if @recipe_days.present? %>
      <ol class="space-y-4">
        <% @recipe_days.each do |day| %>
          <li class="neo-card bg-white p-5 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600"><%= day.day_order %>日目</p>
                <h3 class="text-xl font-black text-slate-900"><%= day.title %></h3>
                <% if day.starts_on.present? %>
                  <p class="mt-1 text-sm font-semibold text-slate-600"><%= day.starts_on.strftime("%Y/%m/%d") %></p>
                <% end %>
              </div>
              <% if owns_recipe? %>
                <div class="flex gap-2 text-sm font-black">
                  <%= link_to edit_recipe_day_path(@recipe, day),
                      class: "neo-btn-brutal bg-white" do %>
                    <%= heroicon("pencil-square", classes: "h-4 w-4") %>
                    <span>編集</span>
                  <% end %>
                  <%= button_to recipe_day_path(@recipe, day), method: :delete,
                      data: { confirm: "この日程を削除しますか？" },
                      class: "neo-btn-brutal bg-white text-red-600" do %>
                    <%= heroicon("trash", classes: "h-4 w-4") %>
                    <span>削除</span>
                  <% end %>
                </div>
              <% end %>
            </div>
            <% if day.notes.present? %>
              <p class="mt-3 text-sm font-semibold leading-relaxed text-slate-700 whitespace-pre-line"><%= day.notes %></p>
            <% else %>
              <p class="mt-3 text-sm font-semibold text-slate-600">まだメモがありません。訪れたいスポットや移動時間をメモしましょう。</p>
            <% end %>

            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h4 class="inline-flex items-center gap-2 text-sm font-black text-slate-900">
                  <%= heroicon("clock", classes: "h-4 w-4") %>
                  <span>タイムライン</span>
                </h4>
                <% if owns_recipe? %>
                  <%= link_to new_recipe_day_step_path(@recipe, day),
                      class: "inline-flex items-center gap-1 text-xs font-black text-primary-600 hover:underline" do %>
                    <%= heroicon("plus-circle", classes: "h-3.5 w-3.5") %>
                    <span>行動を追加</span>
                  <% end %>
                <% end %>
              </div>

              <% if day.recipe_steps.any? %>
                <%= render "recipe_days/steps_list", day: day, recipe: @recipe %>
              <% else %>
                <p class="text-sm font-semibold text-slate-600">
                  <% if owns_recipe? %>
                    行動はまだありません。「＋ 行動を追加」から登録しましょう。
                  <% else %>
                    作成者が行動を追加するとここに表示されます。
                  <% end %>
                </p>
              <% end %>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <div class="neo-dashed text-sm font-semibold text-slate-600">
        <p>日別の行程はまだありません。<% if owns_recipe? %>「＋ 日程を追加」から 1 日目の予定を作成しましょう。<% else %>レシピ作成者が追加すると、ここに日別の予定が表示されます。<% end %></p>
      </div>
    <% end %>
  </section>
</article>

<div class="fixed inset-x-0 bottom-0 z-20 md:hidden bg-[#fffef6]/95 border-t-4 border-slate-900 shadow-[0_-8px_0_0_#0f172a] px-4 py-3 text-sm font-black text-slate-900">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <%= link_to recipes_path, class: "neo-btn-brutal bg-white p-2" do %>
      <%= heroicon("home", classes: "h-4 w-4") %>
    <% end %>
    <button type="button"
            class="neo-btn-brutal bg-white p-2"
            data-controller="scroll-to-top"
            data-action="click->scroll-to-top#scroll">
      <%= heroicon("arrow-up", classes: "h-4 w-4") %>
      <span class="sr-only">ページ上部へ戻る</span>
    </button>
    <% if false %>
      <% if policy(@recipe).update? %>
        <%= link_to edit_recipe_path(@recipe), class: "neo-btn-brutal bg-primary-100 p-2" do %>
          <%= heroicon("pencil-square", classes: "h-4 w-4") %>
        <% end %>
      <% else %>
        <button type="button" class="neo-btn-brutal bg-gray-100 text-gray-400 p-2" disabled>
          <%= heroicon("eye", classes: "h-4 w-4") %>
        </button>
      <% end %>
      <% if policy(@recipe).fork? %>
        <%= button_to fork_recipe_path(@recipe), method: :post, class: "neo-btn-brutal bg-emerald-300 p-2" do %>
          <%= heroicon("arrow-path", classes: "h-4 w-4") %>
        <% end %>
      <% end %>
      <% if policy(@recipe).manage_collaborators? %>
        <%= link_to recipe_collaborators_path(@recipe), class: "neo-btn-brutal bg-white p-2" do %>
          <%= heroicon("users", classes: "h-4 w-4") %>
        <% end %>
        <%= link_to recipe_history_path(@recipe), class: "neo-btn-brutal bg-white p-2" do %>
          <%= heroicon("clock", classes: "h-4 w-4") %>
        <% end %>
      <% end %>

    <% end %>

    <% if owns_recipe? %>
      <%= button_to @recipe, method: :delete, data: { confirm: "本当に削除しますか？" }, class: "neo-btn-brutal bg-white text-red-600 p-2" do %>
        <%= heroicon("trash", classes: "h-4 w-4") %>
      <% end %>
    <% end %>
    <% if false %>
      <% if policy(RecipeReport.new(recipe: @recipe)).create? %>
        <button type="button"
                class="neo-btn-brutal bg-white text-amber-600 p-2"
                data-action="report-modal#open">
          <%= heroicon("exclamation-triangle", classes: "h-4 w-4") %>
          <span class="sr-only"><%= t("recipes.reports.button") %></span>
        </button>
      <% end %>
    <% end %>
    <%= render "shared/components/favorite_button_mobile", recipe: @recipe, saved: @recipe_saved %>
  </div>
</div>

<div data-report-modal-target="backdrop"
     class="fixed inset-0 z-40 hidden items-center justify-center bg-black/40 px-4 py-6"
     role="dialog"
     aria-modal="true"
     aria-labelledby="report-modal-title"
     aria-hidden="true"
     tabindex="-1"
     data-action="click->report-modal#close">
  <div class="w-full max-w-lg" data-action="click->report-modal#stopPropagation">
    <div class="neo-card bg-white p-6 sm:p-8">
      <div class="flex items-center justify-between">
        <h2 id="report-modal-title" class="text-xl font-black text-slate-900"><%= t("recipes.reports.modal.title") %></h2>
        <button type="button"
                class="neo-btn-brutal bg-white p-2"
                data-action="report-modal#close">
          <span class="sr-only"><%= t("recipes.reports.modal.close") %></span>
          <%= heroicon("x-mark", classes: "h-4 w-4") %>
        </button>
      </div>
      <p class="mt-2 text-sm font-semibold text-slate-600"><%= t("recipes.reports.modal.description") %></p>
      <%= form_with model: RecipeReport.new,
                    url: recipe_report_path(@recipe),
                    method: :post,
                    class: "mt-4 space-y-4" do |f| %>
        <% report_reason_options = RecipeReport.reasons.keys.map do |key|
          [ t("recipes.reports.reasons.#{key}"), key ]
        end %>
        <label class="block space-y-2">
          <span class="text-xs font-black uppercase tracking-[0.4em] text-slate-600"><%= t("recipes.reports.modal.reason_label") %></span>
          <%= f.select :reason,
                       options_for_select(report_reason_options),
                       { include_blank: t("recipes.reports.modal.reason_placeholder") },
                       class: "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm font-semibold text-slate-900",
                       required: true %>
        </label>
        <label class="block space-y-2">
          <span class="text-xs font-black uppercase tracking-[0.4em] text-slate-600"><%= t("recipes.reports.modal.comment_label") %></span>
          <%= f.text_area :comment,
                          rows: 3,
                          class: "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm font-semibold text-slate-900",
                          placeholder: t("recipes.reports.modal.comment_placeholder") %>
        </label>
        <div class="flex flex-wrap gap-2">
          <%= f.submit t("recipes.reports.modal.submit"), class: "neo-btn-brutal bg-amber-300" %>
          <button type="button"
                  class="neo-btn-brutal bg-white"
                  data-action="report-modal#close">
            <%= t("recipes.reports.modal.cancel") %>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
</div>

<% fallback_og_image = seo_og_image_url || (request&.base_url.present? ? "#{request.base_url}#{ApplicationHelper::DEFAULT_OG_IMAGE_PATH}" : nil) %>
<% recipe_image_urls = if @recipe.cover_image.attached?
                         [
                           rails_blob_url(@recipe.cover_image.variant(resize_to_fill: [1200, 1200]), host: request.base_url),
                           rails_blob_url(@recipe.cover_image.variant(resize_to_fill: [1200, 900]), host: request.base_url),
                           rails_blob_url(@recipe.cover_image.variant(resize_to_fill: [1200, 675]), host: request.base_url)
                         ]
                       else
                         [fallback_og_image]
                       end.compact_blank %>
<% recipe_schema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "@id": "#{recipe_url(@recipe)}#recipe",
  "name": @recipe.title,
  "description": @recipe.description.presence || "実際に回れた順序をそのまま真似できる旅程レシピ",
  "url": recipe_url(@recipe),
  "image": recipe_image_urls,
  "author": {
    "@type": "Person",
    "name": @recipe.user&.display_name.presence || @recipe.user&.username.presence || "TripRecipe User"
  },
  "recipeCategory": "Travel Itinerary",
  "recipeCuisine": (@recipe.city_label.presence || nil),
  "recipeYield": (@recipe.days_count.present? ? "#{@recipe.days_count} day#{@recipe.days_count.to_i == 1 ? '' : 's'}" : nil),
  "recipeInstructions": @recipe.recipe_days.includes(:recipe_steps).order(:day_order).flat_map do |day|
    day.recipe_steps.order(:position).map do |step|
      {
        "@type": "HowToStep",
        "name": step.title,
        "text": step.notes.presence || step.title,
        "url": recipe_url(@recipe)
      }
    end
  end
} %>
<script type="application/ld+json">
<%= raw(json_escape(recipe_schema.to_json)) %>
</script>
<%# FAQ 構造化データ（公開レシピのみ。共有リンク閲覧時は出さない） %>
<% if @recipe.public? && !@share_link_access_granted %>
  <% faq_schema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": "#{recipe_url(@recipe)}#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "AIが作る旅程と何が違いますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "TripRecipeは実際に回れた順序を、日別・時刻順で残します。混雑回避や休憩ポイントなど、現地で効いたコツが含まれる点が大きな違いです。"
        }
      },
      {
        "@type": "Question",
        "name": "この旅程は公開しないと使えませんか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "公開は必須ではありません。まずは自分用に整理し、必要な場合だけ共有リンクで家族や友人に見せることができます。"
        }
      },
      {
        "@type": "Question",
        "name": "子連れ以外の旅行でも役立ちますか？",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "はい。ひとり旅や友人同士の旅行でも、時刻順の旅程があることで当日の迷いが減ります。移動が多い日やゆっくり過ごす日にも有効です。"
        }
      }
    ]
  } %>
  <script type="application/ld+json">
  <%= raw(json_escape(faq_schema.to_json)) %>
  </script>
<% end %>
