<%# locals: plan, compact: boolean (default false) %>
<% compact = local_assigns.fetch(:compact, false) %>
<%= link_to plan, class: "neo-card flex h-full flex-col justify-between gap-4 p-5 transition duration-150 hover:-translate-y-1" do %>
  <% if plan.cover_image.attached? %>
    <div class="overflow-hidden rounded-2xl border-[3px] border-slate-900 bg-slate-100">
      <%= image_tag plan.cover_image.variant(resize_to_limit: [640, 360]),
                    class: "aspect-[16/9] h-full w-full object-cover",
                    loading: "lazy",
                    alt: "#{plan.title.presence || 'レシピ'}のカバー画像" %>
    </div>
  <% end %>
  <div>
    <div class="flex items-start justify-between gap-3">
      <div class="flex-1">
        <div class="mb-2 inline-flex items-center gap-2 text-xs font-black uppercase tracking-[0.2em] text-slate-700">
          <%= heroicon("map-pin", classes: "h-3.5 w-3.5 tr-primary") %>
          <span class="city-badge"><%= plan.respond_to?(:city_label) ? (plan.city_label.presence || "都市未設定") : "都市未設定" %></span>
        </div>
        <div class="flex items-center gap-2">
          <h3 class="recipe_title text-xl font-black text-slate-900"><%= plan.title.presence || "無題のレシピ" %></h3>
          <% if plan.respond_to?(:favorites_count) && plan.favorites_count.to_i > 0 %>
            <span class="inline-flex items-center gap-1 rounded-full border-[3px] border-slate-900 bg-amber-200 px-3 py-0.5 text-xs font-black text-slate-900"
                  data-testid="favorite-count-badge">
              <%= heroicon("heart", classes: "h-3.5 w-3.5", variant: :solid) %>
              <span class="sr-only">お気に入り数</span>
              <span aria-hidden="true"><%= plan.favorites_count %></span>
            </span>
          <% end %>
        </div>
        <% tags = plan.tags.to_a.first(3) if plan.respond_to?(:tags) %>
        <% if tags.present? %>
          <div class="mt-2 flex flex-wrap gap-2">
            <% tags.each do |tag| %>
              <span class="inline-flex items-center rounded-full border-2 border-slate-900 bg-white px-2.5 py-0.5 text-[11px] font-semibold text-slate-900 shadow-[2px_2px_0_0_rgba(15,23,42,0.3)]">
                <%= tag.display_label %>
              </span>
            <% end %>
          </div>
        <% end %>
      </div>
      <% if false %>
        <span class="inline-flex items-center gap-1 rounded-full tr-surface px-3 py-1 text-xs font-semibold tr-text-sub">
          <%= heroicon("eye", classes: "h-3.5 w-3.5") %>
          <%= plan.public? ? "公開" : "非公開" %>
        </span>
      <% end %>
    </div>
    <% if !compact %>
      <p class="mt-3 text-sm font-semibold text-slate-700"><%= plan.description.presence || "概要は未入力です。" %></p>
      <dl class="mt-4 grid grid-cols-2 gap-3 text-xs font-semibold text-slate-600">
        <div>
          <dt class="inline-flex items-center gap-1 text-slate-900">
            <%= heroicon("calendar", classes: "h-4 w-4") %>
            日数
          </dt>
          <dd class="mt-1"><%= plan.days_count.present? ? "約#{plan.days_count}日" : "未定" %></dd>
        </div>
        <div>
          <dt class="inline-flex items-center gap-1 font-semibold tr-text-sub">
            <%= heroicon("user-circle", classes: "h-4 w-4") %>
            作成者
          </dt>
          <dd class="mt-1"><%= display_user_identifier(plan.user) %></dd>
        </div>
      </dl>
    <% end %>
  </div>
  <div class="flex items-center justify-between text-sm font-black text-primary-600">
    <span>レシピ詳細へ</span>
    <span aria-hidden="true">↗</span>
  </div>
<% end %>
