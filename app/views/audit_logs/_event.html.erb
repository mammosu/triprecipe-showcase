<div class="p-5">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-sm">
      <span class="inline-flex items-center gap-1 rounded-full border-[3px] border-slate-900 bg-gray-100 px-2 py-1 text-xs font-black text-slate-700">
        <%= human_action(log.action) %>
      </span>
      <span class="text-xs font-semibold text-slate-600">
        <%= human_model_name(log.item_type) %>
      </span>
    </div>
    <div class="text-xs font-semibold text-slate-600">
      <%= log.created_at.strftime("%Y/%m/%d %H:%M") %>
    </div>
  </div>
  <div class="mt-1 text-sm font-semibold text-slate-800">
    実行者:
    <%= log.whodunnit.present? ? (User.find_by(id: log.whodunnit)&.email || "不明") : (log.metadata["actor_email"] || "匿名/未設定") %>
  </div>
  <% if log.metadata.present? %>
    <div class="mt-2 text-xs font-semibold text-slate-600 space-y-1">
      <%= format_audit_metadata(log) %>
    </div>
  <% end %>
  <%# PaperTrail 導入後に差分ビューをここに差し替え予定 %>
</div>
