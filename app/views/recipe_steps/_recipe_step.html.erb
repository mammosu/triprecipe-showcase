<%# locals: (step:, day:, recipe:, highlight: false, is_first: false, is_last: false) %>
<div id="<%= dom_id(step) %>" class="relative flex gap-3">
    <%# Dot (shift left to overlap vertical timeline line) %>
    <div class="relative z-10 mt-2 h-5 w-5 -ml-4 rounded-full border-[3px] border-slate-900 tr-primary-bg shadow-[3px_3px_0_0_rgba(15,23,42,0.3)] flex-shrink-0"></div>

    <%# Content %>
    <div class="flex-1 min-w-0">
      <div class="mb-2 flex items-baseline gap-2">
        <span class="text-xs font-black uppercase tracking-wider text-slate-900">
          <%= step.starts_at.strftime("%H:%M") %>
          <% if step.ends_at.present? %>
            (- <%= step.ends_at.strftime("%H:%M") %>)
          <% end %>
        </span>
      </div>

      <div class="neo-card bg-white p-4 group transition-transform duration-200 hover:-translate-y-0.5"
           data-controller="<%= highlight ? "flash" : "" %>"
           data-flash-active-class="bg-amber-50">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-full md:min-w-0">
            <h5 class="text-base font-black text-slate-900"><%= step.title %></h5>
            <div class="mt-2 flex items-center gap-2">
              <p class="text-xs inline-flex items-center gap-1 neo-chip--pill bg-gray-50">
                <%= heroicon("flag", classes: "h-3 w-3") %>
                <%= I18n.t("recipe_steps.category.#{step.category}", default: step.category.titleize) %>
              </p>
              <% if owns_recipe?(recipe) %>
                <div class="ml-auto flex items-center gap-2 text-xs font-semibold text-slate-600 md:hidden">
                  <div class="flex gap-1">
                    <%= button_to move_up_recipe_day_step_path(recipe, day, step),
                        method: :post,
                        class: "inline-flex items-center justify-center rounded-full border-[2px] border-slate-900 bg-white px-2 py-1 hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white shadow-[2px_2px_0_0_rgba(15,23,42,0.3)]",
                        title: "上へ移動",
                        disabled: is_first do %>
                      <%= heroicon("arrow-up", classes: "h-3 w-3") %>
                    <% end %>
                    <%= button_to move_down_recipe_day_step_path(recipe, day, step),
                        method: :post,
                        class: "inline-flex items-center justify-center rounded-full border-[2px] border-slate-900 bg-white px-2 py-1 hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white shadow-[2px_2px_0_0_rgba(15,23,42,0.3)]",
                        title: "下へ移動",
                        disabled: is_last do %>
                      <%= heroicon("arrow-down", classes: "h-3 w-3") %>
                    <% end %>
                  </div>
                  <div class="flex gap-2">
                    <%= link_to edit_recipe_day_step_path(recipe, day, step),
                        class: "inline-flex items-center gap-1 tr-primary font-black hover:underline" do %>
                      編集
                    <% end %>
                    <%= button_to recipe_day_step_path(recipe, day, step),
                        method: :delete,
                        data: { turbo_confirm: "この行動を削除しますか？" },
                        class: "inline-flex items-center gap-1 text-red-600 font-black hover:text-red-700" do %>
                      削除
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <% if owns_recipe?(recipe) %>
            <div class="hidden md:flex flex-col items-end gap-1 text-xs font-semibold text-slate-600 opacity-100 group-hover:opacity-100 transition-opacity md:opacity-0">
              <div class="flex gap-1">
                <%= button_to move_up_recipe_day_step_path(recipe, day, step),
                    method: :post,
                    class: "inline-flex items-center justify-center rounded-full border-[2px] border-slate-900 bg-white px-2 py-1 hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white shadow-[2px_2px_0_0_rgba(15,23,42,0.3)]",
                    title: "上へ移動",
                    disabled: is_first do %>
                  <%= heroicon("arrow-up", classes: "h-3 w-3") %>
                <% end %>
                <%= button_to move_down_recipe_day_step_path(recipe, day, step),
                    method: :post,
                    class: "inline-flex items-center justify-center rounded-full border-[2px] border-slate-900 bg-white px-2 py-1 hover:bg-gray-50 disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-white shadow-[2px_2px_0_0_rgba(15,23,42,0.3)]",
                    title: "下へ移動",
                    disabled: is_last do %>
                  <%= heroicon("arrow-down", classes: "h-3 w-3") %>
                <% end %>
              </div>
              <div class="flex gap-2 mt-1">
                <%= link_to edit_recipe_day_step_path(recipe, day, step),
                    class: "inline-flex items-center gap-1 tr-primary font-black hover:underline" do %>
                  編集
                <% end %>
                <%= button_to recipe_day_step_path(recipe, day, step),
                    method: :delete,
                    data: { turbo_confirm: "この行動を削除しますか？" },
                    class: "inline-flex items-center gap-1 text-red-600 font-black hover:text-red-700" do %>
                  削除
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if step.photos.attached? %>
          <% photos = step.photos.first(3) %>
          <% photo_urls = photos.map { |photo| url_for(photo.variant(resize_to_limit: [1200, 1200])) } %>
          <div class="mt-4 grid grid-cols-3 gap-2">
            <% photos.each_with_index do |photo, index| %>
              <div id="<%= dom_id(photo) %>" class="group relative aspect-[4/3] w-full overflow-hidden rounded-lg border tr-border-strong tr-surface shadow-sm">
                <%= button_tag type: "button",
                               class: "h-full w-full focus:outline-none focus:ring-1 focus:ring-primary-500",
                               data: { action: "click->photo-modal#open",
                                       photo_url: photo_urls[index],
                                       photo_alt: "#{step.title}の写真",
                                       photo_modal_urls_value: json_escape(photo_urls.to_json),
                                       photo_modal_index_value: index } do %>
                  <%= image_tag photo.variant(resize_to_limit: [320, 320]), alt: "#{step.title}の写真", class: "h-full w-full object-cover" %>
                <% end %>

                <% if owns_recipe?(recipe) %>
                  <%= link_to recipe_day_step_photo_path(recipe, day, step, photo),
                              data: { turbo_method: :delete, turbo_confirm: "この写真を削除しますか？" },
                              class: "absolute right-1 top-1 hidden h-7 w-7 items-center justify-center rounded-full bg-white/90 text-slate-900 shadow-sm transition-opacity duration-150 hover:bg-white md:inline-flex md:opacity-0 md:pointer-events-none md:group-hover:opacity-100 md:group-hover:pointer-events-auto md:focus:opacity-100 md:focus:pointer-events-auto",
                              aria: { label: "写真を削除" } do %>
                    <%= heroicon("trash", classes: "h-3.5 w-3.5") %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>

        <% if step.notes.present? %>
          <div class="mt-4 border-[3px] border-amber-500 bg-amber-50 p-3 rounded-xl">
            <p class="text-xs font-black text-amber-800 mb-2 flex items-center gap-1 uppercase tracking-wider">
              <%= heroicon("light-bulb", classes: "h-3.5 w-3.5") %>
              コツ
            </p>
            <p class="text-sm font-semibold text-amber-900 leading-relaxed whitespace-pre-line"><%= step.notes %></p>
          </div>
        <% end %>
      </div>
    </div>
</div>
