<% content_for :title, "アカウント設定" %>
<% field_class = "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm font-semibold text-slate-900 placeholder-slate-400 focus:border-primary-500 focus:outline-none focus:ring-0" %>

<div class="space-y-6">
  <section class="neo-panel bg-white p-6">
    <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">アカウント</p>
    <h1 class="mt-2 text-3xl font-black text-slate-900">アカウント設定</h1>
    <p class="mt-2 text-sm font-semibold text-slate-700">登録情報やパスワードをここで更新できます。</p>
  </section>

  <section class="neo-panel bg-white p-6">
    <%= render "devise/shared/flash_messages" %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), method: :put, local: true, class: "space-y-6") do |f| %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="space-y-2 sm:col-span-2">
          <%= f.label :email, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
            <%= heroicon("envelope", classes: "h-4 w-4") %>
            <span>メールアドレス</span>
          <% end %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: field_class %>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="text-xs tr-text-sub">確認中のメール: <%= resource.unconfirmed_email %></p>
          <% end %>
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs font-black uppercase tracking-[0.4em] text-slate-600">
            <%= f.label :password, class: "inline-flex items-center gap-1 uppercase" do %>
              <%= heroicon("key", classes: "h-4 w-4") %>
              <span>PASSWORD</span>
            <% end %>
            <% if @minimum_password_length %>
              <span class="normal-case text-slate-700"><%= @minimum_password_length %>文字以上</span>
            <% end %>
          </div>
          <p class="text-xs font-semibold text-slate-600">変更しない場合は空欄でOK</p>
          <%= f.password_field :password,
                autocomplete: "new-password",
                class: field_class %>
        </div>

        <div class="space-y-2">
          <%= f.label :password_confirmation, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
            <%= heroicon("key", classes: "h-4 w-4") %>
            <span>確認用パスワード</span>
          <% end %>
          <%= f.password_field :password_confirmation,
                autocomplete: "new-password",
                class: field_class %>
        </div>

        <div class="space-y-2 sm:col-span-2">
          <%= f.label :current_password, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
            <%= heroicon("lock-closed", classes: "h-4 w-4") %>
            <span>現在のパスワード</span>
          <% end %>
          <p class="text-xs font-semibold text-slate-600">保存には現在のパスワードが必要です。</p>
          <%= f.password_field :current_password,
                autocomplete: "current-password",
                required: true,
                class: field_class %>
        </div>
      </div>

      <%= f.submit "変更を保存", class: "w-full neo-btn-brutal bg-primary-100 justify-center text-sm font-black" do %>
        <%= heroicon("check-circle", classes: "h-4 w-4") %>
        <span>変更を保存</span>
      <% end %>
    <% end %>
  </section>

  <div class="grid gap-4 md:grid-cols-2">
    <section class="rounded-[28px] border-[3px] border-rose-400 bg-rose-50/70 p-5 text-sm font-semibold text-rose-700 shadow-[8px_8px_0_0_rgba(244,63,94,0.2)]">
      <h2 class="inline-flex items-center gap-2 text-base font-black text-rose-700">
        <%= heroicon("trash", classes: "h-5 w-5") %>
        <span>アカウントを削除</span>
      </h2>
      <p class="mt-1">削除すると保存済みのレシピもすべて消えます。</p>
      <%= button_to registration_path(resource_name),
                    method: :delete,
                    data: { confirm: "本当に削除しますか？この操作は元に戻せません。" },
                    class: "mt-4 w-full neo-btn-brutal bg-white text-rose-600 justify-center text-sm font-black" do %>
        <%= heroicon("trash", classes: "h-4 w-4") %>
        <span>アカウントを削除</span>
      <% end %>
    </section>

    <section class="neo-panel bg-[#f4f1ec] p-5 text-sm font-semibold text-slate-700">
      <h2 class="inline-flex items-center gap-2 text-base font-black text-slate-900">
        <%= heroicon("question-mark-circle", classes: "h-5 w-5") %>
        <span>その他のアクション</span>
      </h2>
      <div class="mt-3">
        <%= render "devise/shared/links" %>
      </div>
    </section>
  </div>
</div>
