<% content_for :title, "ログイン" %>
<% field_class = "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm font-semibold text-slate-900 placeholder-slate-400 focus:border-primary-500 focus:outline-none focus:ring-0" %>

<div class="mx-auto w-full max-w-md space-y-6">
  <section class="neo-panel bg-white p-6">
    <div class="mb-6 text-center space-y-2">
      <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">TripRecipe</p>
      <h1 class="text-3xl font-black text-slate-900">ログイン</h1>
      <p class="text-sm font-semibold text-slate-700">保存した旅程やレシピを確認しましょう。</p>
    </div>

    <%= render "devise/shared/flash_messages" %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_with(model: resource, as: resource_name, url: session_path(resource_name), class: "space-y-5", local: true) do |f| %>
      <div class="space-y-2">
        <%= f.label :email, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
          <%= heroicon("envelope", classes: "h-4 w-4") %>
          <span>メールアドレス</span>
        <% end %>
        <%= f.email_field :email,
              autofocus: true,
              required: true,
              class: field_class %>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-black uppercase tracking-[0.4em] text-slate-600">
          <%= f.label :password, class: "inline-flex items-center gap-1 uppercase" do %>
            <%= heroicon("lock-closed", classes: "h-4 w-4") %>
            <span>PASSWORD</span>
          <% end %>
          <% if devise_mapping.recoverable? %>
            <%= link_to "パスワードを忘れた場合", new_password_path(resource_name), class: "text-primary-600 hover:underline" %>
          <% end %>
        </div>
        <%= f.password_field :password,
              autocomplete: "current-password",
              required: true,
              class: field_class %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
          <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-[3px] border-slate-900 text-primary-600 focus:ring-primary-500" %>
          <span>ログイン状態を保持する</span>
        </label>
      <% end %>

      <%= f.submit "ログイン", class: "w-full neo-btn-brutal bg-primary-100 justify-center text-sm font-black" do %>
        <%= heroicon("lock-closed", classes: "h-4 w-4") %>
        <span>ログイン</span>
      <% end %>
    <% end %>
  </section>

  <section class="neo-panel bg-[#f4f1ec] p-5 text-sm font-semibold text-slate-700">
    <h2 class="inline-flex items-center gap-2 text-sm font-black text-slate-900">
      <%= heroicon("question-mark-circle", classes: "h-4 w-4") %>
      <span>その他の操作</span>
    </h2>
    <div class="mt-3">
      <%= render "devise/shared/links" %>
    </div>
  </section>
</div>
