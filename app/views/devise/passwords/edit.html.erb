<% content_for :title, "パスワード更新" %>
<% field_class = "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm font-semibold text-slate-900 placeholder-slate-400 focus:border-primary-500 focus:outline-none focus:ring-0" %>

<div class="mx-auto w-full max-w-md space-y-6">
  <section class="neo-panel bg-white p-6">
    <div class="mb-6 text-center space-y-2">
      <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">Password</p>
      <h1 class="text-3xl font-black text-slate-900">新しいパスワードを設定</h1>
      <p class="text-sm font-semibold text-slate-700">メールで受け取ったリンクからアクセスしています。</p>
    </div>

    <%= render "devise/shared/flash_messages" %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_with(model: resource, as: resource_name, url: password_path(resource_name), html: { method: :put }, class: "space-y-5", local: true) do |f| %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-2">
        <div class="flex items-center justify-between text-xs font-black uppercase tracking-[0.4em] text-slate-600">
          <%= f.label :password, class: "inline-flex items-center gap-1 uppercase" do %>
            <%= heroicon("key", classes: "h-4 w-4") %>
            <span>PASSWORD</span>
          <% end %>
          <% if @minimum_password_length %>
            <span class="normal-case text-slate-700">最低<%= @minimum_password_length %>文字</span>
          <% end %>
        </div>
        <%= f.password_field :password,
              autocomplete: "new-password",
              required: true,
              class: field_class %>
      </div>

      <div class="space-y-2">
        <%= f.label :password_confirmation, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
          <%= heroicon("key", classes: "h-4 w-4") %>
          <span>確認用パスワード</span>
        <% end %>
        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              required: true,
              class: field_class %>
      </div>

      <%= f.submit "パスワードを更新", class: "w-full neo-btn-brutal bg-primary-100 justify-center text-sm font-black" do %>
        <%= heroicon("check-circle", classes: "h-4 w-4") %>
        <span>パスワードを更新</span>
      <% end %>
    <% end %>
  </section>

  <section class="neo-panel bg-[#f4f1ec] p-5 text-sm font-semibold text-slate-700">
    <h2 class="inline-flex items-center gap-2 text-sm font-black text-slate-900">
      <%= heroicon("question-mark-circle", classes: "h-4 w-4") %>
      <span>別の操作</span>
    </h2>
    <div class="mt-3">
      <%= render "devise/shared/links" %>
    </div>
  </section>
</div>
