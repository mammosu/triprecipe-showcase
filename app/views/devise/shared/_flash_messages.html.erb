<% if flash[:alert].present? || flash[:notice].present? %>
  <div class="mb-6 space-y-3 text-sm font-semibold">
    <% if flash[:alert].present? %>
      <p class="rounded-[24px] border-[3px] border-red-500 bg-rose-50 px-4 py-2 text-red-700 shadow-[6px_6px_0_0_rgba(244,63,94,0.25)]">
        <%= flash[:alert] %>
      </p>
    <% end %>
    <% if flash[:notice].present? %>
      <p class="rounded-[24px] border-[3px] border-emerald-500 bg-emerald-50 px-4 py-2 text-emerald-700 shadow-[6px_6px_0_0_rgba(16,185,129,0.25)]">
        <%= flash[:notice] %>
      </p>
    <% end %>
  </div>
<% end %>
