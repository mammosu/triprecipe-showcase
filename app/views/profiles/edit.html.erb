<% content_for :title, "プロフィール編集" %>
<% field_class = "w-full rounded-2xl border-[3px] border-slate-900 bg-white px-3 py-2 text-sm font-semibold text-slate-900 placeholder-slate-400 focus:border-primary-500 focus:outline-none focus:ring-0" %>

<div class="space-y-6">
  <section class="neo-panel bg-white p-6">
    <p class="text-xs font-black uppercase tracking-[0.4em] text-slate-600">Profile</p>
    <h1 class="mt-2 text-3xl font-black text-slate-900">プロフィール編集</h1>
    <p class="mt-2 text-sm font-semibold text-slate-700">表示名・ユーザー名・自己紹介・アイコンを更新できます。</p>
  </section>

  <section class="neo-panel bg-white p-6">
    <%= render "devise/shared/error_messages", resource: @user %>

    <%= form_with(model: @user, url: profile_path, method: :patch, local: true, class: "space-y-6", html: { multipart: true }) do |f| %>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="space-y-2 sm:col-span-2">
          <%= f.label :display_name, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
            <%= heroicon("user-circle", classes: "h-4 w-4") %>
            <span>表示名</span>
          <% end %>
          <%= f.text_field :display_name,
                placeholder: "例: 旅好きのさくら",
                maxlength: 30,
                class: field_class %>
        </div>

        <div class="space-y-2 sm:col-span-2">
          <%= f.label :username, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
            <%= heroicon("at-symbol", classes: "h-4 w-4") %>
            <span>ユーザー名</span>
          <% end %>
          <%= f.text_field :username,
                placeholder: "例: trip_sakura",
                maxlength: 20,
                class: field_class %>
          <p class="text-xs font-semibold text-slate-600">英数字とアンダースコアのみ。将来 URL に使う予定です。</p>
        </div>

        <div class="space-y-2 sm:col-span-2">
          <%= f.label :bio, class: "inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600" do %>
            <%= heroicon("pencil-square", classes: "h-4 w-4") %>
            <span>自己紹介</span>
          <% end %>
          <%= f.text_area :bio,
                rows: 4,
                maxlength: 160,
                placeholder: "旅のスタイルや得意エリアなどをひとこと",
                class: field_class %>
        </div>

        <div class="space-y-2 sm:col-span-2">
          <p class="inline-flex items-center gap-1 text-xs font-black uppercase tracking-[0.4em] text-slate-600">
            <%= heroicon("photo", classes: "h-4 w-4") %>
            アイコン
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar.variant(resize_to_limit: [160, 160]),
                            class: "h-24 w-24 rounded-full border-[3px] border-slate-900 object-cover",
                            alt: "#{@user.display_name.presence || "ユーザー"}のアイコン" %>
            <% else %>
              <div class="flex h-24 w-24 items-center justify-center rounded-full border-[3px] border-dashed border-slate-300 text-sm font-semibold text-slate-500">
                No Image
              </div>
            <% end %>
            <%= f.file_field :avatar,
                  accept: "image/*",
                  class: "text-sm font-semibold text-slate-700" %>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap gap-3">
        <%= f.submit "プロフィールを保存", class: "neo-btn-brutal bg-primary-100 text-sm font-black" do %>
          <%= heroicon("check-circle", classes: "h-4 w-4") %>
          <span>プロフィールを保存</span>
        <% end %>
        <%= link_to "アカウントへ戻る", account_path, class: "neo-btn-brutal bg-white text-sm font-black" %>
      </div>
    <% end %>
  </section>
</div>
