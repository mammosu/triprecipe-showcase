<% form_url = recipe_day.persisted? ? recipe_day_path(@recipe, recipe_day) : recipe_days_path(@recipe) %>
<%= form_with(model: recipe_day, url: form_url, class: "space-y-6") do |form| %>
  <% if recipe_day.errors.any? %>
    <section class="rounded-[28px] border-[3px] border-red-500 bg-rose-50 p-5 text-sm font-semibold text-red-700 shadow-[12px_12px_0_0_rgba(239,68,68,0.25)]">
      <p><%= pluralize(recipe_day.errors.count, "件") %>の入力エラーがあります。</p>
      <ul class="mt-2 list-disc pl-5">
        <% recipe_day.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <div class="neo-panel bg-white p-6 space-y-5">
    <div>
      <%= form.label :title, "日程タイトル", class: "block text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
      <p class="text-xs font-semibold text-slate-600">例: 1日目 バルセロナ旧市街散策</p>
      <%= form.text_field :title, class: "mt-2 w-full rounded-2xl border-[3px] border-slate-900 px-4 py-3 focus:border-primary-500 focus:outline-none focus:ring-0" %>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <%= form.label :starts_on, "日付", class: "block text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
        <%= form.date_field :starts_on, class: "mt-2 w-full rounded-2xl border-[3px] border-slate-900 px-4 py-3 focus:border-primary-500 focus:outline-none focus:ring-0" %>
      </div>
      <div>
        <%= form.label :day_order, "表示順", class: "block text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
        <p class="text-xs font-semibold text-slate-600">1 から順番に並びます。未入力の場合は末尾に追加。</p>
        <%= form.number_field :day_order, in: 1..60, class: "mt-2 w-full rounded-2xl border-[3px] border-slate-900 px-4 py-3 focus:border-primary-500 focus:outline-none focus:ring-0" %>
      </div>
    </div>

    <div>
      <%= form.label :notes, "メモ", class: "block text-xs font-black uppercase tracking-[0.4em] text-slate-600" %>
      <%= form.text_area :notes, rows: 5, class: "mt-2 w-full rounded-2xl border-[3px] border-slate-900 px-4 py-3 focus:border-primary-500 focus:outline-none focus:ring-0" %>
    </div>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.submit class: "neo-btn-brutal bg-primary-100 text-sm font-black" do %>
      <%= heroicon("check-circle", classes: "h-4 w-4") %>
      <span>保存する</span>
    <% end %>
    <%= link_to recipe_path(@recipe), class: "neo-btn-brutal bg-white text-sm font-black" do %>
      <%= heroicon("arrow-top-right-on-square", classes: "h-4 w-4") %>
      <span>キャンセル</span>
    <% end %>
  </div>
<% end %>
