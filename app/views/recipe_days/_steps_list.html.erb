<%# locals: (day:, recipe:, highlight_step_id: nil) %>
<div id="<%= dom_id(day, :steps_list) %>"
     class="relative pl-4 space-y-6">
  <%# Vertical Line: Connects top to bottom - Neobrutalism style %>
  <div class="absolute left-2 top-2 bottom-2 w-[3px] bg-slate-900"></div>

  <% steps = day.recipe_steps.with_attached_photos.order(:position) %>
  <% steps.each_with_index do |item, index| %>
    <%= render "recipe_steps/recipe_step",
          step: item,
          day: day,
          recipe: recipe,
          highlight: (item.id == highlight_step_id),
          is_first: index == 0,
          is_last: index == steps.size - 1
    %>
  <% end %>
</div>
