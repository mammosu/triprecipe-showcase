#!/usr/bin/env bash
set -euo pipefail

DB_PATH="/data/production.sqlite3"
LS_CONFIG="/rails/config/litestream.yml"

echo "[fly-start] ensure permissions (same policy as fly_db_prepare)"
STORAGE_DIR="/rails/storage"
DATA_DIR="/data"
if id -u rails >/dev/null 2>&1; then
  chown -R rails:rails "$STORAGE_DIR" "$DATA_DIR" 2>/dev/null || true
else
  chown -R root:root "$STORAGE_DIR" "$DATA_DIR" 2>/dev/null || true
fi
chmod -R u+rwX,g+rwX,o-rwx "$STORAGE_DIR" "$DATA_DIR" 2>/dev/null || true

# 1) DB がなければ restore
if [ ! -f "$DB_PATH" ]; then
  echo "[fly-start] DB not found. Restoring from Litestream..."
  litestream restore -config "$LS_CONFIG" -o "$DB_PATH"
fi

# 2) migrate
echo "[fly-start] running db:prepare"
./bin/rails db:prepare

# 3) replicate しながら Rails 起動
echo "[fly-start] starting litestream replicate + rails server"
exec litestream replicate -config "$LS_CONFIG" \
  -exec "./bin/rails server -b 0.0.0.0 -p ${PORT:-8080}"

# 3) start web (NO litestream for now)
# echo "[fly-start] starting rails server"
# exec ./bin/rails server -b 0.0.0.0 -p ${PORT:-8080}
